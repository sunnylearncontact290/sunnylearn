# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin & Notification settings
ADMIN_EMAIL="sanaa0419z@gmail.com"
ADMIN_PASSWORD="S.04:29.learn"

# Public Contact & Support Email
CONTACT_EMAIL="sunnylearn.contact@gmail.com"

# Optional SMTP Configuration for direct email dispatch (Gmail App Password or SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="sanaa0419z@gmail.com"
SMTP_PASS=""

# Optional Google OAuth Client ID for Google Identity Services (GSI)
VITE_GOOGLE_CLIENT_ID=""

